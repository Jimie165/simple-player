{
    "productName": "Simple Player",
    "version": "0.2.0",
    "identifier": "com.maho.simpleplayer",
    "build": {
        "beforeDevCommand": "pnpm --filter simple-player-ui dev",
        "beforeBuildCommand": "pnpm --filter simple-player-ui build",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../../frontend/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Simple Player",
                "width": 1000,
                "height": 700,
                "minWidth": 600,
                "minHeight": 500,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "shadow": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' asset: tauri: http://asset.localhost https://asset.localhost blob: data:; media-src 'self' asset: tauri: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval';",
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "**"
                ]
            },
            "capabilities": [
                "default"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "externalBin": [
            "binaries/ffmpeg",
            "binaries/ffprobe"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "languages": [
                    "English",
                    "SimpChinese"
                ]
            },
            "wix": {
                "language": [
                    "en-US",
                    "zh-CN"
                ]
            }
        }
    }
}
