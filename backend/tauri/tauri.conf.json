{
    "productName": "Simple Player",
    "version": "0.1.0",
    "identifier": "com.simple.player",
    "build": {
        "beforeDevCommand": "pnpm --filter frontend dev",
        "beforeBuildCommand": "pnpm --filter frontend build",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../../frontend/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Simple Player",
                "width": 1000,
                "height": 700,
                "minWidth": 600,
                "minHeight": 500,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "shadow": true
            }
        ],
        "security": {
            "csp": null,
            "capabilities": [
                "default"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}